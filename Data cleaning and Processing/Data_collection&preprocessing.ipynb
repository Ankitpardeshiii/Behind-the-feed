   "source": [
    "# Collecting and slicing data into chunks "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "0af5cc8d-5c83-42f0-9eb8-7649fb72a4ad",
   "metadata": {},
   "outputs": [],
   "source": [
    "with open(\"initialdata.txt\" , encoding = \"utf-8\" ) as f :\n",
    "    data = f.read()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "8e3bc4ca-7e53-4f33-9c16-b20a2ddae146",
   "metadata": {},
   "outputs": [],
   "source": [
    "chunks = data.split(\"\\n\\n\")\n",
    "chunks = [ c for c in chunks if len(c)>3]"
   ]
  }
